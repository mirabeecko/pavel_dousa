# ===== Customer Platform — env kontrakt (kopíruj do .env.local) =====

# Povinné — base URL Site API (public, žádné secrets)
NEXT_PUBLIC_PLATFORM_SITE_API_URL=http://127.0.0.1:8000

# Povinné — veřejný website identifikátor (public_id w_... nebo UUID)
# Web dousa-elektro.cz v Customer Platform (služba "dousa-elektro.cz").
NEXT_PUBLIC_PLATFORM_WEBSITE_ID=w_GzmFTZrP5dEn_vfK

# Volitelné — media ID pro demo obrázek (ID objektu z Media knihovny)
NEXT_PUBLIC_PLATFORM_MEDIA_ID=

# Volitelné — formKey formuláře (FormDefinition public_id). Pokud ho page
# config neobsahuje (sekce "form"), použije se tento fallback.
NEXT_PUBLIC_PLATFORM_FORM_KEY=frm_xxx

# Volitelné — POUZE preview buildy. NIKDY do produkčního buildu.
# PLATFORM_PREVIEW_TOKEN=

# Volitelné — bounded revalidation (sekundy). 0 = force-dynamic.
REVALIDATE_SECONDS=30
